
[
  {
    // build and test inside podman, see Containerfile for the build environment
    "label": "podman: build + test",
    "command": "$ZED_WORKTREE_ROOT/.zed/podman-build-test.sh",
    "args": ["$ZED_WORKTREE_ROOT"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },

  {
    // e2e tests: real binary on xvfb inside podman, report in e2e/artifacts/report.html
    "label": "podman: e2e tests",
    "command": "$ZED_WORKTREE_ROOT/e2e/run.sh",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },

  {
    // run build made by podman, with config and state in .zed so the host config is untouched
    "label": "run app",
    "command": "./target/podman/debug/kuterm",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "XDG_CONFIG_HOME": "$ZED_WORKTREE_ROOT/.zed/config",
      "XDG_STATE_HOME": "$ZED_WORKTREE_ROOT/.zed/state"
    },
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  
  {
    "label": "run app, refresh settings",
    "command": "./target/podman/debug/kuterm",
    "args": ["--recreate-confs"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "XDG_CONFIG_HOME": "$ZED_WORKTREE_ROOT/.zed/config",
      "XDG_STATE_HOME": "$ZED_WORKTREE_ROOT/.zed/state"
    },
    "save": "all",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
