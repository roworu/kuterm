// kuterm settings
//
// this file is created with default values on first launch.
// comments and trailing commas are allowed, missing values use their defaults.
// changes are applied as soon as this file or a file it imports is saved.
// if it is invalid, the last good settings are kept and the error is shown in the window,
// at launch all defaults are used.
{
  // other settings files merged before this one, so values set here win over theirs, like
  //   ["~/.config/kuterm/colors.jsonc", "local.jsonc"]
  // relative paths are resolved from this folder, imported files can import more files.
  // a missing file is skipped with a warning
  "import": [],

  // font used for tabs and other ui text
  "ui_font_family": "JetBrainsMonoNL Nerd Font Mono",
  // ui font size in pixels, the whole ui scales with it
  // font sizes go from 6 to 72
  "ui_font_size": 18,
  // hide the tab bar while only one tab is open, ctrl-t still opens new tabs
  "hide_bar_for_one_tab": true,
  // stretch tabs to fill the whole tab bar, sharing its width equally
  "expand_tabs": false,
  // tab width in pixels when "expand_tabs" is false, wheel scrolls tabs that don't fit
  "tab_width": 220,
  // tab title, built from these blocks in order:
  //   "number"                                 - tab position, starting at 1
  //   "prompt"                                 - user@host
  //   "folder"                                 - name of the current folder
  //   "command"                                - name of the running program
  //   "title"                                  - title set by the running program
  //   { "text": " < AMONGUS > " }              - any text
  //   { "exec": "git branch --show-current" }  - first line of a command's output, run in the current folder
  // titles refresh every second
  // example:
  //   ["number", { "text": ": " }, "folder", { "text": " > " }, "command"]
  "tab_title": ["folder", { "text": " - " }, "command"],
  // where the title sits inside its tab: "left", "center" or "right"
  "tab_title_align": "left",
  // icon shown in each tab
  "tab_icon": {
    // side of the tab it sits on: "left" or "right"
    "position": "left",
    // follow running program, like ssh or htop. false always shows "default"
    "dynamic": true,
    // icon of the shell and of programs without own icon
    "default": "",
  },
  // show the "×" close button on the active tab and on hovered ones, middle click still closes tabs
  "show_tab_close_button": true,
  // drag tabs with the mouse to reorder them
  "drag_tabs": true,
  // ask before closing a tab while a program still runs in it, like vim or a long build
  "close_running_tab_warn": true,
  // ask before quitting or closing the window:
  //   "always"  - every time
  //   "running" - only while a program still runs in some tab
  //   "never"   - quit right away
  "confirm_quit": "running",
  // where the "+" new tab button sits: "left" or "right" end of the tab bar, or "after_tabs" next to the last tab
  "new_tab_button": "after_tabs",
  // window title, built from the active tab with the same blocks as "tab_title"
  "window_title": ["folder", { "text": " - " }, "command"],
  // used by "title" when the running program set none, and as window title when it is empty
  "default_title": "kuterm",

  "command_palette": {
    // allow opening the command palette with its key, commands are set in "commands" below
    "enable": true,
    // list recently run commands first, right after pinned ones
    "show_recent": true,
  },

  "notifications": {
    // show notifications inside the window, like when a command from the palette finishes
    "enable": true,
    // seconds a notification stays, 0 keeps it until clicked
    // timeout goes from 0 to 3600
    "timeout": 5,
    // notify when text is copied, long text is shortened
    "copy": true,
    // notify when text is pasted
    "paste": true,
    // notifications programs send with osc 9 or osc 777, like "printf '\\e]9;done\\a'":
    //   "always"    - always, as a system notification too while the window is not focused
    //   "unfocused" - only while the tab is not in front of a focused window
    //   "never"     - never
    "from_programs": "unfocused",
  },

  // open the tabs and splits of the last session on launch, each in the folder its shell
  // was in. programs that ran in them are not started again:
  //   "always" - every launch
  //   "ask"    - a notification asks
  //   "never"  - start with one new tab
  // the session is kept in session.json in the state folder
  "restore_session": "never",

  // images programs show with kitty's graphics protocol, like "kitten icat" or yazi. they
  // scroll with the text and are drawn over cell backgrounds
  "graphics": {
    "enable": true,
    // megabytes of decoded images each tab keeps, the oldest go first, from 1 to 4096
    "max_memory_mb": 320,
  },

  // let other programs drive kuterm:
  //   "off"    - no
  //   "socket" - through a unix socket in $XDG_RUNTIME_DIR, used by "kuterm msg new-tab",
  //              "kuterm msg send-text", "kuterm msg list-tabs" and
  //              "kuterm --single-instance". shells started by kuterm get its path in
  //              $KUTERM_SOCKET
  "remote_control": "off",

  // the "open_scrollback" action writes the history of the active tab, colors kept, to a
  // temp file and opens it with this command in a new tab, the file goes last
  "scrollback_pager": ["less", "-R", "+G"],

  // shell integration: shells mark their prompts and commands and tell their folder.
  // prompts can then be jumped to, the output of the last command selected or copied, and
  // new tabs and splits open in the folder of the shell
  "shell_integration": {
    // load kuterm's integration scripts into bash, zsh and fish started by a profile without
    // arguments, like "system" or { "program": "zsh" }. other shells can print the marks
    // themselves (osc 133 and osc 7)
    "inject": true,
    // notify when a command took longer than this many seconds and its tab is not in front,
    // 0 never notifies
    "notify_after": 10,
  },

  // focus a split pane when the mouse moves over it, without clicking
  "focus_follows_mouse": false,

  // split panes, made with the "split_*" actions or by dragging a tab onto a pane edge
  "panes": {
    // pixels between two panes, from 0 to 20, dividers can be dragged
    "divider_width": 1,
    // darken panes without focus, from 0 (off) to 1
    "dim_inactive": 0.0,
    // the shell a split starts opens in the folder of the tab that was split
    "split_inherits_cwd": true,
  },

  // what happens when a program rings the bell, like a shell on a failed tab completion
  "bell": {
    // flash over the terminal that fades out
    "visual": {
      "enable": true,
      // flash color as a hex string, alpha keeps text readable, like "#ffffff40".
      // null uses a faint terminal text color
      "color": null,
      // milliseconds the flash takes to fade out, from 0 to 2000
      "duration": 150,
    },
    // play the system bell sound
    "audio": false,
    // ask the desktop to highlight the window when it is not focused, on x11 and macos
    "urgent": true,
    // show a bell icon on a background tab that rang, until it is opened
    "tab_indicator": true,
  },

  // search in the history of a tab, opened with the "search" key (ctrl-shift-f by default).
  // enter goes to the match above, shift-enter to the one below, escape closes it.
  // these are the starting options, the buttons of the search bar change them
  "search": {
    // tell upper and lower case apart: "smart" only when the query has an upper case letter,
    // true always, false never
    "case_sensitive": "smart",
    // read the query as a regular expression, like "err(or)?\\b"
    "regex": false,
    // match whole words only
    "whole_word": false,
  },

  // links in the terminal: osc 8 hyperlinks that programs like ls --hyperlink print, and text
  // matched by "patterns". holding the modifier underlines the link under the mouse, a click
  // with it held opens it
  "links": {
    // "ctrl", "alt", "shift" or "super" (windows key, cmd on macos)
    "modifier": "ctrl",
    // program that opens links, like "firefox". null uses the system opener (xdg-open, open)
    "open_with": null,
    // regexes tried on the line under the mouse, the list replaces this one.
    // "action" is what a click does:
    //   "open"                  - open with "open_with"
    //   "copy"                  - copy the text to the clipboard
    //   "paste"                 - type the text into the terminal
    //   { "exec": "code -g \"$KUTERM_MATCH\"" } - run a shell command, the text is in $KUTERM_MATCH
    "patterns": [
      { "regex": "(https?|ftp|file)://[^\\s<>\"'`(){}\\[\\]]*[^\\s<>\"'`(){}\\[\\].,;:!?]", "action": "open" },
    ],
  },

  // hints: the "hints" key (ctrl-shift-e by default) puts a short label on every match of
  // these patterns on screen, typing a label runs the action of its pattern, escape cancels
  "hints": {
    // letters labels are made of, at least two different ones
    "alphabet": "asdfghjkl",
    // like "links.patterns", with a "name" to tell them apart. the list replaces this one.
    // "\\b" here is written "(?-u:\\b)", the regex engine only knows ascii word boundaries
    "patterns": [
      { "name": "url", "regex": "(https?|ftp|file)://[^\\s<>\"'`(){}\\[\\]]*[^\\s<>\"'`(){}\\[\\].,;:!?]", "action": "open" },
      { "name": "path", "regex": "(~|\\.{1,2})?(/[\\w.+@-]+)+/?", "action": "copy" },
      { "name": "hash", "regex": "(?-u:\\b)[0-9a-f]{7,40}(?-u:\\b)", "action": "copy" },
      { "name": "ip", "regex": "(?-u:\\b)[0-9]{1,3}(\\.[0-9]{1,3}){3}(:[0-9]+)?(?-u:\\b)", "action": "copy" },
    ],
  },

  "theme": {
    // which theme to use, applied right away when the system switches:
    //   "system" - follow system dark/light preference
    //   "dark"   - always dark
    //   "light"  - always light
    "mode": "system",
    // theme for each mode: a name from "themes" below, a name of a file in the "themes"
    // folder next to this file, like "nord" for themes/nord.jsonc, or a path to a theme file
    // with the same keys, like "~/mine.jsonc" (relative paths are resolved from this folder).
    // null uses the bundled theme
    "dark": "dark",
    "light": "light",
    // themes by name, add your own next to these. colors are hex strings: "#rgb", "#rgba",
    // "#rrggbb" or "#rrggbbaa". colors left out of a theme come from the bundled theme of
    // the mode it is used for
    "themes": {
      // one dark
      "dark": {
        // tab bar
        "tab_bar_background": "#2f343e",
        "tab_active_background": "#282c33",
        "border": "#464b57",
        "text": "#dce0e5",
        "text_muted": "#a9afbc",

        // buttons that destroy something, like "close" in the dialog asking to close a busy tab
        "danger_button": "#be5046",
        "danger_button_text": "#ffffff",

        // terminal
        "terminal_background": "#282c34",
        "terminal_foreground": "#abb2bf",
        "cursor": "#74ade8",
        "selection": "#3e4451",
        "scrollbar": "#4e5666",
        // background of search matches, and of the one search is on
        "search_match": "#4b4a3a",
        "search_match_active": "#8a6a2a",
        "bright_foreground": "#dce0e5",
        "dim_foreground": "#636d83",

        // 16 ansi colors, must have exactly 16 entries
        "ansi": [
          // normal: black, red, green, yellow, blue, magenta, cyan, white
          "#282c34", "#e06c75", "#98c379", "#e5c07b", "#61afef", "#c678dd", "#56b6c2", "#abb2bf",
          // bright: black, red, green, yellow, blue, magenta, cyan, white
          "#636d83", "#ea858b", "#aad581", "#ffd885", "#85c1ff", "#d398eb", "#6ed5de", "#fafafa",
        ],
        // dim ansi colors, must have exactly 8 entries
        // black, red, green, yellow, blue, magenta, cyan, white
        "ansi_dim": ["#3b3f4a", "#a7545a", "#6d8f59", "#b8985b", "#457cad", "#8d54a0", "#3c818a", "#8f969b"],
      },
      // one light
      "light": {
        // tab bar
        "tab_bar_background": "#ebebec",
        "tab_active_background": "#fafafa",
        "border": "#c9c9ca",
        "text": "#383a42",
        "text_muted": "#6a6b70",

        // buttons that destroy something, like "close" in the dialog asking to close a busy tab
        "danger_button": "#e45649",
        "danger_button_text": "#ffffff",

        // terminal
        "terminal_background": "#fafafa",
        "terminal_foreground": "#383a42",
        "cursor": "#526fff",
        "selection": "#e5e5e6",
        "scrollbar": "#c4c4c7",
        // background of search matches, and of the one search is on
        "search_match": "#f3e7b5",
        "search_match_active": "#f0c35a",
        "bright_foreground": "#202227",
        "dim_foreground": "#a0a1a7",

        // 16 ansi colors, must have exactly 16 entries
        "ansi": [
          // normal: black, red, green, yellow, blue, magenta, cyan, white
          "#383a42", "#e45649", "#50a14f", "#c18401", "#0184bc", "#a626a4", "#0997b3", "#a0a1a7",
          // bright: black, red, green, yellow, blue, magenta, cyan, white
          "#4f525e", "#e06c75", "#98c379", "#e5c07b", "#61afef", "#c678dd", "#56b6c2", "#ffffff",
        ],
        // dim ansi colors, must have exactly 8 entries
        // black, red, green, yellow, blue, magenta, cyan, white
        "ansi_dim": ["#727479", "#eb877e", "#83bc82", "#d2a74c", "#4ca7cf", "#bf66be", "#51b5c8", "#b8b9bd"],
      },
    },
  },

  "window": {
    // pixels between the window edges and the terminal text, from 0 to 200
    "padding": { "x": 4, "y": 4 },
    // the grid is made of whole cells, so some pixels are left over at the right and bottom.
    // true splits them equally on both sides
    "padding_balance": false,
    // terminal background opacity from 0 (see through) to 1 (solid), text stays solid.
    // cells colored by programs stay solid too, needs a compositor on linux
    "opacity": 1.0,
    // blur what is behind the window when "opacity" is below 1, only where the system
    // supports it, like kde and macos
    "blur": false,
    // window frame, linux only:
    //   "full"   - title bar and borders from the window manager
    //   "none"   - no frame, drag the empty part of the tab bar to move the window
    //   "client" - like "none", with minimize, maximize and close buttons in the tab bar
    // the tab bar stays shown with one tab when it is not "full"
    "decorations": "full",
    // terminal size in cells the window opens with, columns from 10 to 1000, rows from 2 to 500
    "columns": 100,
    "rows": 30,
    // how the window opens: "windowed", "maximized" or "fullscreen"
    "startup": "windowed",
    // open with the last size of the window instead of "columns" and "rows", the size is
    // kept in window_size.json in the state folder
    "remember_size": false,
  },

  "terminal": {
    // the old "font_family" and "font_size" keys still work and set "font.family" and "font.size"
    "font": {
      // bundled "JetBrainsMonoNL Nerd Font Mono" is always available
      "family": "JetBrainsMonoNL Nerd Font Mono",
      // font size in pixels, from 6 to 72
      "size": 20,
      // faces for styled text. a "family" of null uses the regular family with the matching
      // weight or style, a family that is not installed is skipped
      // weight goes from 100 to 900, 700 is bold
      "bold": { "family": null, "weight": 700 },
      // style: "italic", "oblique" or "normal" to draw italic text upright
      "italic": { "family": null, "style": "italic" },
      // null uses the regular family with the bold weight and the italic style
      "bold_italic": { "family": null },
    },
    // opentype font features: "ss01" or "+ss01" turns one on, "-calt" turns one off,
    // "cv01=2" picks a variant. the list replaces this one, so keep "-calt" to keep
    // ligatures off, they draw several cells as one glyph
    "font_features": ["-calt"],
    // fonts tried in order for characters the font lacks, before the system fallback, like
    //   ["Noto Sans CJK JP", "Noto Color Emoji"]
    // fonts that are not installed are skipped
    "font_fallbacks": [],
    // pixels added to the measured cell width, negative values make cells narrower.
    // from -10 to 10
    "cell_width": 0,
    // pixels to move glyphs inside their cell, for fonts that sit too high or too low.
    // positive values move right and down, from -10 to 10
    "glyph_offset": { "x": 0, "y": 0 },
    // bold text in the 8 normal ansi colors uses their bright versions
    "bold_is_bright": false,
    // minimum contrast ratio between text and its background, from 1 (off) to 21.
    // text below it is moved toward black or white until it passes, 4.5 is the wcag
    // level for normal text
    "minimum_contrast": 1,
    // opacity of faint (dim) text whose color has no dim version in the theme, from 0 to 1
    "dim_opacity": 0.7,
    // draw box drawing lines (─│┌╔), blocks (▀█░) and powerline arrows () as shapes
    // that fill the cell exactly, so they connect at any "line_height".
    // false draws them with the font
    "builtin_box_drawing": true,
    // line height as a multiple of font size:
    //   "standard"          - 1.3
    //   "comfortable"       - 1.618
    //   { "custom": 1.5 }   - any value from 1 to 3
    "line_height": "standard",
    // cursor shape: "block", "bar", "underline" or "hollow"
    "cursor_shape": "bar",
    "cursor": {
      // cursor color as a hex string like "#ff8800", null uses the theme "cursor" color
      "color": null,
      // color of the character under a block cursor, null uses the theme "terminal_background"
      "text_color": null,
      // pixels a "bar" or "underline" cursor is thick, from 1 to 8
      "thickness": 2,
      // cursor while the terminal is not focused:
      //   "hollow" - outline of a block
      //   "same"   - the focused shape
      //   "none"   - not drawn
      "unfocused": "hollow",
    },
    // cursor blinking:
    //   "on"  - always blink
    //   "off" - never blink
    //   "app" - blink only when the running program asks for it
    "cursor_blink": "app",
    // milliseconds the blinking cursor stays shown, then hidden, from 100 to 2000
    "cursor_blink_interval": 500,
    // seconds without typing after which the cursor stops blinking and stays shown,
    // so an idle window does not repaint. 0 blinks forever, up to 3600
    "cursor_blink_timeout": 15,
    // lines of scrollback history to keep, 0 keeps everything
    "max_history_length": 10000,
    // macos only: option key works as meta, so option-b sends esc b like alt-b does on linux.
    // false keeps option typing special characters like ∫
    "option_as_meta": false,
    // copy selected text into the clipboard as soon as the mouse button is released
    "select_to_copy": false,
    // right click copies selected text into the clipboard
    "right_click_copy": true,
    // drop spaces and tabs at the end of each copied line
    "copy_trim_trailing_whitespace": true,
    // characters that end a word when double clicking to select it
    "word_separators": " ,│`|:\"'()[]{}<>\t",
    // lines scrolled per mouse wheel step, also speeds up touchpad scrolling, from 0.1 to 20
    "scroll_multiplier": 2,
    // hide the mouse pointer when typing, moving the mouse shows it again
    "hide_mouse_when_typing": true,
    "scrollbar": {
      // when to show it:
      //   "on"      - always
      //   "off"     - never
      //   "dynamic" - only when there is history to scroll
      "enable": "dynamic",
      // side of the terminal it sits on: "left" or "right"
      "placement": "right",
      // width in pixels, from 2 to 64
      "width": 8,
      // hide after this many seconds without scrolling. 0 never hides.
      "auto_hide": 10,
    },
    // glide to the new position smoothly instead of jumping
    "smooth_scroll": {
      "enable": true,
      // how long one glide takes in milliseconds, from 0 to 1000
      "duration": 300,
      // speed curve of the glide:
      //   "linear"      - same speed all the way
      //   "ease_out"    - fast start, soft stop
      //   "ease_in_out" - soft start and soft stop
      "easing": "ease_out",
    },
    // what programs may do with the clipboard through osc 52 escape sequences, even over ssh:
    //   "allow" - right away
    //   "ask"   - show a notification with allow and deny buttons
    //   "deny"  - never
    // reading lets a program see anything copied before, like passwords, so it is denied
    "clipboard": { "write": "allow", "read": "deny" },
    // ask before pasting text with a newline while the program did not turn on bracketed
    // paste, since a shell runs it right away, or text with control characters like escape.
    // with bracketed paste on, control characters are always removed from pasted text
    "paste_protection": true,
  },

  // what new tabs start with. ctrl-shift-t and a click on "+" open the default profile,
  // a right click on "+" picks any profile when there is more than one.
  // "name" and "command" are required, the other keys can be left out.
  // changes to a profile apply to tabs opened after them.
  "profiles": [
    {
      // shown in the profile menu
      "name": "default",
      // only one profile can be default, the first one is used when none is
      "default": true,
      // program to launch:
      //   "system"                                                   - login shell of current user
      //   { "program": "zsh" }                                       - specific program
      //   { "with_arguments": { "program": "bash", "args": ["--login"] } } - program with arguments
      "command": "system",
      // folder to start in, "~" is the home folder, null uses the folder kuterm started in
      "working_directory": null,
      // color scheme, "mode", "dark" and "light" like in "theme" above, names come from
      // "theme.themes", like { "mode": "dark", "dark": "red" }. null uses "theme"
      "theme": null,
      // tab icon, kept whatever runs in the tab. null uses "tab_icon"
      "icon": null,
      // extra environment variables, like { "EDITOR": "vim" }
      "env": {},
    },
  ],

  // keys for actions. a bound key is never sent to the terminal, so defaults use ctrl-shift
  // combinations that shells and editors like vim don't rely on (ctrl-w, ctrl-t, ctrl-c... keep
  // reaching them). missing actions keep their default keys.
  //
  // each action maps to one key, written as modifiers and a key joined by "-":
  //   modifiers: "ctrl", "alt", "shift", "super" (windows / cmd key), "fn"
  //   keys: letters, digits, "tab", "enter", "space", "escape", "f1".."f12", ...
  //   "ctrl-shift-t"   - ctrl, shift and t together
  //   "ctrl-a t"       - ctrl-a, then t (keys separated by spaces are pressed one after another)
  //   null             - no key, the action is disabled
  // macos uses cmd keys instead, see "os" at the end of this file
  "keybindings": {
    // open a new tab
    "new_tab": "ctrl-shift-t",
    // close the active tab
    "close_tab": "ctrl-shift-w",
    // switch to the tab on the right, wrapping around to the first one
    "next_tab": "ctrl-tab",
    // copy text selected with the mouse to clipboard
    "copy": "ctrl-shift-c",
    // paste from clipboard into the terminal
    "paste": "ctrl-shift-v",
    // search the history of the active tab
    "search": "ctrl-shift-f",
    // label links, paths, hashes and other "hints.patterns" matches on screen, typing a
    // label runs its action
    "hints": "ctrl-shift-e",
    // split the focused pane, moving its active tab to the new pane on that side
    "split_left": null,
    "split_right": null,
    "split_up": null,
    "split_down": null,
    // close the focused pane with all its tabs
    "close_pane": null,
    // move focus to the pane on that side
    "focus_pane_left": null,
    "focus_pane_right": null,
    "focus_pane_up": null,
    "focus_pane_down": null,
    // move the divider next to the focused pane that way
    "resize_pane_left": null,
    "resize_pane_right": null,
    "resize_pane_up": null,
    "resize_pane_down": null,
    // show the focused pane alone, again to show all panes
    "zoom_pane": null,
    // give all panes the same size
    "equalize_panes": null,
    // scroll to the prompt above or below, needs shell integration
    "jump_to_prev_prompt": "ctrl-shift-up",
    "jump_to_next_prompt": "ctrl-shift-down",
    // select or copy what the last command printed, needs shell integration
    "select_last_output": null,
    "copy_last_output": null,
    // open the history of the active tab in "scrollback_pager"
    "open_scrollback": null,
    // keyboard selection mode: hjkl, w/b/e, 0/$, gg/G, ctrl-u/ctrl-d move, v, V and ctrl-v
    // select, / searches and n/N go to the next match, y copies, escape leaves.
    // a number before a motion repeats it, like 5j
    "vi_mode": "ctrl-shift-space",
    // open command palette
    "command_palette": "ctrl-shift-p",
    // toggle fullscreen
    "toggle_fullscreen": "f11",
    // quit, asking first when programs still run in some tabs
    "quit": null,
    // hide kuterm, macos only
    "hide": null,
    // hide every other app, macos only
    "hide_others": null,
    // minimize the window
    "minimize": null,
    // switch to the tab on the left, wrapping around to the last one
    "prev_tab": "ctrl-shift-tab",
    // select the whole history and screen of the active tab
    "select_all": null,
    // drop the active tab's history, its prompt moves to the top
    "clear": null,
    // make the active tab font one pixel bigger, ctrl + mouse wheel too
    "increase_font_size": "ctrl-=",
    // make the active tab font one pixel smaller
    "decrease_font_size": "ctrl--",
    // set the active tab font back to its size from settings
    "reset_font_size": "ctrl-0",
    // open settings.jsonc in the system text editor
    "open_settings": null,
    // read this file and the files it uses again, they are also read on every save
    "reload_config": null,
    // switch to tab by its position, any "activate_tab_<n>" with n from 1 up can be added
    "activate_tab_1": "alt-1",
    "activate_tab_2": "alt-2",
    "activate_tab_3": "alt-3",
    "activate_tab_4": "alt-4",
    "activate_tab_5": "alt-5",
    "activate_tab_6": "alt-6",
    "activate_tab_7": "alt-7",
    "activate_tab_8": "alt-8",
    "activate_tab_9": "alt-9",
  },

  // more keys, added after "keybindings" so they win over them. each entry has "keys", an
  // "action" and, optionally, "when" the keys work:
  //   "action": any action name of "keybindings", like "new_tab"
  //             "unbind" - the keys do nothing in kuterm and reach the terminal program
  //             a command palette action, like { "send_text": "\u001b[2J" } that sends
  //             text to the program right away, or { "new_tab_with_profile": "dev" }
  //   "when":   "terminal", "search" (the search bar), "palette", "vi_mode" or "alt_screen"
  //             (full screen programs like vim). left out works everywhere
  // keys pressed one after another, like "ctrl-a c", wait 1 second for the next one.
  // example:
  //   [
  //     { "keys": "ctrl-a c", "action": "new_tab" },
  //     { "keys": "ctrl-shift-k", "action": { "send_text": "\u001b[2J" } },
  //     { "keys": "ctrl-shift-t", "action": "unbind", "when": "alt_screen" },
  //   ]
  "keymap": [],

  // command palette commands. the palette opens with the "command_palette" key (ctrl-shift-p by
  // default), typing filters commands by name, enter or a click runs the picked one. recently run
  // commands are listed first, this can be turned off with "command_palette.show_recent".
  //
  // each command has a "name" shown in the palette and "actions" run one after another.
  // an optional "category" is shown before the name and groups the list, so
  // { "name": "create new", "category": "tabs" } appears as "tabs: create new".
  // a command with "pinned": true stays at the very top of the palette. hover its pin icon
  // and click the x to unpin it, those picks are saved in pinned_commands.json in the state
  // folder ($XDG_STATE_HOME/kuterm, ~/.local/state/kuterm by default).
  //
  // actions run against the active tab, or against the tab opened by an earlier
  // "new_background_tab" of the same command.
  //
  // actions:
  //   "about"                            - show a page with the version and links
  //   "reload_config"                    - read this file, its imports and theme files again
  //   "new_tab"                          - open a tab with the default profile
  //   { "new_tab_with_profile": "dev" }  - open a tab with the named profile
  //   "new_background_tab"               - open a tab without switching to it
  //   { "new_background_tab_with_profile": "dev" } - same, with the named profile
  //   "close_tab"                        - close the active tab
  //   "close_tabs_to_right"              - close every tab to the right of the active one
  //   "close_tabs_to_left"               - close every tab to the left of the active one
  //   "split_left"                       - split the focused pane, moving its active tab left
  //   "split_right"                      - split the focused pane, moving its active tab right
  //   "split_up"                         - split the focused pane, moving its active tab above
  //   "split_down"                       - split the focused pane, moving its active tab below
  //   "close_pane"                       - close the focused pane with all its tabs
  //   "focus_pane_left"                  - focus the pane on the left, also _right, _up, _down
  //   "resize_pane_left"                 - move the divider of the focused pane left, also
  //                                        _right, _up, _down
  //   "zoom_pane"                        - show the focused pane alone, again to show all
  //   "equalize_panes"                   - give all panes the same size
  //   "next_tab"                         - switch to the tab on the right
  //   "prev_tab"                         - switch to the tab on the left
  //   { "activate_tab": 2 }              - switch to the tab at this 1 based position
  //   "pick_tab"                         - list the open tabs in the palette, pick one to switch to it
  //   "copy"                             - copy the active tab's selection to the clipboard
  //   "paste"                            - paste the clipboard into the active tab
  //   "search"                           - open the search bar of the active tab
  //   "hints"                            - label matches of "hints.patterns" on screen
  //   "vi_mode"                          - start or end keyboard selection mode
  //   "jump_to_prev_prompt"              - scroll to the prompt above, needs shell integration
  //   "jump_to_next_prompt"              - scroll to the prompt below
  //   "select_last_output"               - select what the last command printed
  //   "copy_last_output"                 - copy what the last command printed
  //   "open_scrollback"                  - open the history in "scrollback_pager" in a new tab
  //   { "scroll_up": 10 }                - scroll the active tab up by this many lines
  //   { "scroll_down": 10 }              - scroll the active tab down by this many lines
  //   "scroll_top"                       - scroll the active tab to the top of its history
  //   "scroll_bottom"                    - scroll the active tab back to the prompt
  //   "quit"                             - close every tab and exit, asks first while programs run
  //   "select_all"                       - select the active tab's whole history and screen
  //   "clear"                            - drop the active tab's history, its prompt moves to the top
  //   "increase_font_size"               - make the active tab font one pixel bigger
  //   "decrease_font_size"               - make the active tab font one pixel smaller
  //   "reset_font_size"                  - set the active tab font back to its size from settings
  //   "open_settings"                    - open settings.jsonc in the system text editor
  //   { "type": "ls\n" }                 - type text into the active tab, "\n" presses enter
  //   { "send_text": "\u001b[A" }         - send text to the program right away, escapes too
  //   { "notify": "hi" }                 - show a notification inside the window
  //   { "notify_when_done": "built" }    - show a notification once the program running in the
  //                                        tab finishes, clicking it switches to that tab
  //
  // actions can be mixed freely to build bigger commands, see the examples below.
  "commands": [
    { "name": "about", "category": "app", "actions": ["about"] },
    { "name": "quit", "category": "app", "actions": ["quit"] },

    { "name": "reload config", "category": "config", "actions": ["reload_config"] },
    { "name": "open settings", "category": "config", "actions": ["open_settings"] },

    { "name": "copy selection", "category": "edit", "actions": ["copy"] },
    { "name": "paste", "category": "edit", "actions": ["paste"] },
    { "name": "select all", "category": "edit", "actions": ["select_all"] },
    { "name": "search", "category": "edit", "actions": ["search"] },
    { "name": "hints", "category": "edit", "actions": ["hints"] },
    { "name": "keyboard selection", "category": "edit", "actions": ["vi_mode"] },
    { "name": "copy last output", "category": "edit", "actions": ["copy_last_output"] },
    { "name": "open history in pager", "category": "view", "actions": ["open_scrollback"] },
    { "name": "select last output", "category": "edit", "actions": ["select_last_output"] },
    { "name": "clear history", "category": "edit", "actions": ["clear"] },

    { "name": "create new", "category": "tabs", "actions": ["new_tab"] },
    { "name": "close current", "category": "tabs", "actions": ["close_tab"] },
    { "name": "close tabs to the right", "category": "tabs", "actions": ["close_tabs_to_right"] },
    { "name": "close tabs to the left", "category": "tabs", "actions": ["close_tabs_to_left"] },
    { "name": "split left", "category": "tabs", "actions": ["split_left"] },
    { "name": "split right", "category": "tabs", "actions": ["split_right"] },
    { "name": "split up", "category": "tabs", "actions": ["split_up"] },
    { "name": "split down", "category": "tabs", "actions": ["split_down"] },
    { "name": "close pane", "category": "panes", "actions": ["close_pane"] },
    { "name": "zoom pane", "category": "panes", "actions": ["zoom_pane"] },
    { "name": "equalize panes", "category": "panes", "actions": ["equalize_panes"] },
    { "name": "switch to left", "category": "tabs", "actions": ["prev_tab"] },
    { "name": "switch to right", "category": "tabs", "actions": ["next_tab"] },
    { "name": "go to tab", "category": "tabs", "actions": ["pick_tab"] },

    { "name": "scroll to top", "category": "view", "actions": ["scroll_top"] },
    { "name": "scroll to bottom", "category": "view", "actions": ["scroll_bottom"] },
    { "name": "bigger font", "category": "view", "actions": ["increase_font_size"] },
    { "name": "smaller font", "category": "view", "actions": ["decrease_font_size"] },
    { "name": "reset font size", "category": "view", "actions": ["reset_font_size"] },

    // custom command example: open a new tab and run a command in it
    {
      "name": "say hello in new tab",
      "category": "examples",
      "actions": ["new_tab", { "type": "echo hello from kuterm\n" }],
    },
    // custom command example: list the folder, then jump to the top of the output
    {
      "name": "list files from the top",
      "category": "examples",
      "actions": [{ "type": "ls -la\n" }, "scroll_top"],
    },
    // custom command example: run a slow command in a background tab, get notified when it ends
    {
      "name": "sleep in the background",
      "category": "examples",
      "actions": [
        "new_background_tab",
        { "type": "sleep 3 && echo woke up\n" },
        { "notify_when_done": "sleep finished" },
      ],
    },
  ],

  // icons of programs in tabs, when "tab_icon.dynamic" is on.
  // more icons to use are listed on https://www.nerdfonts.com/cheat-sheet
  "tab_icons": {
    // programs started through these are matched by their script, like "pi" in "node /usr/bin/pi"
    "interpreters": ["node", "nodejs", "bun", "deno", "python", "python3", "ruby", "perl"],
    // programs that run another one, like "htop" in "sudo htop", show the icon of the program they run
    "wrappers": ["sudo", "doas", "run0", "pkexec", "env", "nice", "nohup", "timeout"],
    "groups": [
      {
        // remote shells
        "icon": "",
        "commands": ["ssh", "mosh", "telnet", "sftp", "ftp", "lftp", "scp", "rlogin", "rsh", "autossh", "sshpass"],
      },
      {
        // network tools
        "icon": "",
        "commands": ["ping", "ping6", "traceroute", "tracepath", "mtr", "nmap", "dig", "nslookup", "host", "whois", "netstat", "ss", "tcpdump", "tshark", "iperf", "iperf3", "nc", "ncat", "netcat", "socat", "arp", "iftop", "nethogs", "bandwhich", "nload", "speedtest", "speedtest-cli"],
      },
      {
        // downloads
        "icon": "󰇚",
        "commands": ["curl", "wget", "aria2c", "xh", "http"],
      },
      {
        // ai and agents
        "icon": "󰚩",
        "commands": ["claude", "opencode", "pi", "codex", "gemini", "aider", "crush", "goose", "amp", "cursor-agent", "copilot", "qwen", "llama-cli", "llama-server", "llama-bench", "ollama", "llm", "droid", "kiro-cli"],
      },
      {
        // system monitors
        "icon": "󰨇",
        "commands": ["htop", "btop", "top", "atop", "bpytop", "bashtop", "glances", "nvtop", "iotop", "btm", "gotop", "gtop", "zenith", "s-tui", "bottom"],
      },
      {
        // editors
        "icon": "",
        "commands": ["vi", "vim", "nvim", "nano", "micro", "hx", "helix", "emacs", "kak", "vis"],
      },
      {
        // git
        "icon": "",
        "commands": ["git", "lazygit", "tig", "gitui", "gh"],
      },
      {
        // containers
        "icon": "󰡨",
        "commands": ["docker", "podman", "lazydocker", "docker-compose", "podman-compose"],
      },
      {
        // kubernetes
        "icon": "󱃾",
        "commands": ["kubectl", "k9s", "helm", "kubectx", "kubens", "minikube", "kind"],
      },
      {
        // package managers
        "icon": "󰏖",
        "commands": ["apt", "apt-get", "aptitude", "dpkg", "nala", "dnf", "dnf5", "yum", "rpm", "rpm-ostree", "zypper", "pacman", "yay", "paru", "pamac", "apk", "emerge", "xbps-install", "eopkg", "nix", "nix-env", "flatpak", "snap", "brew", "pkg"],
      },

      {
        // compilers and build tools
        "icon": "",
        "commands": [
          "gcc", "g++", "cc", "c++", "clang", "clang++", "zig", "rustc", "cargo", "go", "javac", "kotlinc", "make", "gmake", "cmake", "ninja", "meson", "mvn", "gradle", "python", "python3"
        ],
      }
    ]
  },

  // values for one os only, merged over everything else on that os:
  //   "linux", "macos", "freebsd", ...
  // like { "linux": { "terminal": { "font": { "size": 14 } } } }
  "os": {
    "macos": {
      "links": { "modifier": "super" },
      // macos apps use cmd keys, the shell never gets them, so ctrl-w, ctrl-t, ctrl-c... keep
      // reaching it
      "keybindings": {
        "new_tab": "cmd-t",
        "close_tab": "cmd-w",
        "copy": "cmd-c",
        "paste": "cmd-v",
        "search": "cmd-f",
        "hints": "cmd-shift-e",
        "vi_mode": "cmd-shift-space",
        "jump_to_prev_prompt": "cmd-up",
        "jump_to_next_prompt": "cmd-down",
        "command_palette": "cmd-shift-p",
        "toggle_fullscreen": "ctrl-cmd-f",
        "quit": "cmd-q",
        "hide": "cmd-h",
        "hide_others": "alt-cmd-h",
        "minimize": "cmd-m",
        "select_all": "cmd-a",
        "clear": "cmd-k",
        "increase_font_size": "cmd-=",
        "decrease_font_size": "cmd--",
        "reset_font_size": "cmd-0",
        "open_settings": "cmd-,",
        "activate_tab_1": "cmd-1",
        "activate_tab_2": "cmd-2",
        "activate_tab_3": "cmd-3",
        "activate_tab_4": "cmd-4",
        "activate_tab_5": "cmd-5",
        "activate_tab_6": "cmd-6",
        "activate_tab_7": "cmd-7",
        "activate_tab_8": "cmd-8",
        "activate_tab_9": "cmd-9",
      },
    },
  },
}
