// kuterm keybindings
//
// this file is created with default values on first launch.
// comments and trailing commas are allowed, missing actions keep their default keys.
// if this file is invalid, all defaults are used and an error is printed.
// changes are applied on next launch.
//
// a bound key is never sent to the terminal, so defaults use ctrl-shift combinations that shells
// and editors like vim don't rely on (ctrl-w, ctrl-t, ctrl-c... keep reaching them).
//
// each action maps to one key, written as modifiers and a key joined by "-":
//   modifiers: "ctrl", "alt", "shift", "super" (windows / cmd key), "fn"
//   keys: letters, digits, "tab", "enter", "space", "escape", "f1".."f12", ...
//   "ctrl-shift-t"   - ctrl, shift and t together
//   "ctrl-a t"       - ctrl-a, then t (keys separated by spaces are pressed one after another)
//   null             - no key, the action is disabled
{
  // open a new tab
  "new_tab": "ctrl-shift-t",
  // close the active tab
  "close_tab": "ctrl-shift-w",
  // switch to the tab on the right, wrapping around to the first one
  "next_tab": "ctrl-tab",
  // copy text selected with the mouse to clipboard
  "copy": "ctrl-shift-c",
  // paste from clipboard into the terminal
  "paste": "ctrl-shift-v",
  // open command palette
  "command_palette": "ctrl-shift-p",
  // toggle fullscreen
  "toggle_fullscreen": "f11",
  // quit, asking first when programs still run in some tabs
  "quit": null,
  // hide kuterm, macos only
  "hide": null,
  // hide every other app, macos only
  "hide_others": null,
  // minimize the window
  "minimize": null,
  // switch to the tab on the left, wrapping around to the last one
  "prev_tab": "ctrl-shift-tab",
  // select the whole history and screen of the active tab
  "select_all": null,
  // drop the active tab's history, its prompt moves to the top
  "clear": null,
  // make the active tab font one pixel bigger, ctrl + mouse wheel too
  "increase_font_size": "ctrl-=",
  // make the active tab font one pixel smaller
  "decrease_font_size": "ctrl--",
  // set the active tab font back to its size from settings
  "reset_font_size": "ctrl-0",
  // open settings.jsonc in the system text editor
  "open_settings": null,
  // switch to tab by its position, any "activate_tab_<n>" with n from 1 up can be added
  "activate_tab_1": "alt-1",
  "activate_tab_2": "alt-2",
  "activate_tab_3": "alt-3",
  "activate_tab_4": "alt-4",
  "activate_tab_5": "alt-5",
  "activate_tab_6": "alt-6",
  "activate_tab_7": "alt-7",
  "activate_tab_8": "alt-8",
  "activate_tab_9": "alt-9",
}
