{
 "name": "su",
 "description": "Run a shell as another user",
 "options": [
  {
   "name": [
    "-m",
    "-p",
    "--preserve-environment"
   ],
   "description": "Do not reset environment variables"
  },
  {
   "name": [
    "-w",
    "--whitelist-environment"
   ],
   "description": "Don't reset specified variables",
   "args": {
    "name": "list"
   }
  },
  {
   "name": [
    "-g",
    "--group"
   ],
   "description": "Specify the primary group",
   "args": {
    "name": "group"
   }
  },
  {
   "name": [
    "-G",
    "--supp-group"
   ],
   "description": "Specify a supplemental group",
   "args": {
    "name": "group"
   }
  },
  {
   "name": [
    "-l",
    "--login"
   ],
   "description": "Make the shell a login shell"
  },
  {
   "name": [
    "-c",
    "--command"
   ],
   "description": "Pass a single command to the shell with -c",
   "args": {
    "name": "command"
   }
  },
  {
   "name": "--session-command",
   "description": "Pass a single command to the shell with -c",
   "args": {
    "name": "command"
   }
  },
  {
   "name": [
    "-f",
    "--fast"
   ],
   "description": "Pass -f to the shell (for csh or tcsh)"
  },
  {
   "name": [
    "-s",
    "--shell"
   ],
   "description": "Run <shell> if /etc/shells allows it",
   "args": {
    "name": "shell"
   }
  },
  {
   "name": [
    "-P",
    "--pty"
   ],
   "description": "Create a new pseudo-terminal"
  },
  {
   "name": [
    "-T",
    "--no-pty"
   ],
   "description": "Do not create a new pseudo-terminal (bad security!)"
  },
  {
   "name": [
    "-h",
    "--help"
   ],
   "description": "Display this help"
  },
  {
   "name": [
    "-V",
    "--version"
   ],
   "description": "Display version"
  }
 ],
 "args": {
  "name": "user",
  "isOptional": true
 }
}
