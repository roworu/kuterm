  },
  {
   "name": "history-redo",
   "description": "Redo transactions"
  },
  {
   "name": "history-undo",
   "description": "Undo transactions"
  },
  {
   "name": "history-rollback",
   "description": "Rollback transactions"
  },
  {
   "name": "edit-sources",
   "description": "Edit the source information file"
  },
  {
   "name": "modernize-sources",
   "description": "Modernize .list files to .sources files"
  },
  {
   "name": "satisfy",
   "description": "Satisfy dependency strings"
  },
  {
   "name": "why",
