   "priority": 75
  },
  {
   "name": "search",
   "description": "Search in package descriptions",
   "priority": 75,
   "args": {
    "name": "pattern"
   }
  },
  {
   "name": "show",
   "description": "Show package details",
   "priority": 75,
   "args": {
    "name": "package",
    "isVariadic": true
   }
  },
  {
   "name": "install",
   "description": "Install packages",
   "priority": 76,
   "args": {
    "name": "package",
    "isVariadic": true
   }
  },
  {
