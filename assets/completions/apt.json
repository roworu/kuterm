   ],
   "description": "Answer yes to all prompts",
   "isPersistent": true
  },
  {
   "name": [
    "-s",
    "--simulate",
    "--dry-run"
   ],
   "description": "Show what would happen, change nothing",
   "isPersistent": true
  },
  {
   "name": [
    "-q",
    "--quiet"
   ],
   "description": "Print less, -qq even less",
   "isPersistent": true
  },
  {
   "name": "--no-install-recommends",
