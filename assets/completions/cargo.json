{
 "name": "cargo",
 "description": "Rust's package manager",
 "subcommands": [
  {
   "name": [
    "build",
    "b"
   ],
   "description": "Compile the current package",
   "options": [
    {
     "name": [
      "-p",
      "--package"
     ],
     "description": "Package to work on",
     "args": {
      "name": "spec"
     }
    },
    {
     "name": "--workspace",
     "description": "Every package of the workspace"
    },
    {
     "name": [
      "-F",
      "--features"
     ],
     "description": "Features to turn on",
     "args": {
      "name": "features"
     }
    },
    {
     "name": "--all-features",
     "description": "Turn on all features"
    },
    {
     "name": "--no-default-features",
     "description": "Leave the default feature off"
    },
    {
     "name": "--release",
     "description": "Build optimized artifacts"
    },
    {
     "name": "--target",
     "description": "Build for this target triple",
     "args": {
      "name": "triple"
     }
    },
    {
     "name": [
      "-j",
      "--jobs"
     ],
     "description": "Parallel jobs",
     "args": {
      "name": "n"
     }
    },
    {
     "name": "--bin",
     "description": "Only this binary",
     "args": {
      "name": "name"
     }
    },
    {
     "name": "--examples",
     "description": "All examples"
    },
    {
     "name": "--all-targets",
     "description": "All targets"
    }
   ],
   "priority": 80
  },
