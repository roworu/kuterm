{
 "name": "uname",
 "description": "Print system information",
 "options": [
  {
   "name": [
    "-a",
    "--all"
   ],
   "description": "Behave as though all of the options -mnrsvo were specified"
  },
  {
   "name": [
    "-s",
    "--kernel-name"
   ],
   "description": "Print the kernel name"
  },
  {
   "name": [
    "-n",
    "--nodename"
   ],
   "description": "Print the nodename (the nodename may be a name that the system is known by to a…"
  },
  {
   "name": [
    "-r",
    "--kernel-release"
   ],
   "description": "Print the operating system release"
  },
  {
   "name": [
    "-v",
    "--kernel-version"
   ],
   "description": "Print the operating system version"
  },
  {
   "name": [
    "-m",
    "--machine"
   ],
   "description": "Print the machine hardware name"
  },
  {
   "name": [
    "-o",
    "--operating-system"
   ],
   "description": "Print the operating system name"
  },
  {
   "name": [
    "-h",
    "--help"
   ],
   "description": "Print help"
  },
  {
   "name": [
    "-V",
    "--version"
   ],
   "description": "Print version"
  }
 ]
}
