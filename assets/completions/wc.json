{
 "name": "wc",
 "description": "Print line, word and byte counts",
 "options": [
  {
   "name": [
    "-c",
    "--bytes"
   ],
   "description": "Print the byte counts"
  },
  {
   "name": [
    "-m",
    "--chars"
   ],
   "description": "Print the character counts"
  },
  {
   "name": "--files0-from",
   "description": "Read input from the files specified by",
   "args": {
    "name": "f"
   }
  },
  {
   "name": [
    "-l",
    "--lines"
   ],
   "description": "Print the newline counts"
  },
  {
   "name": [
    "-L",
    "--max-line-length"
   ],
   "description": "Print the length of the longest line"
  },
  {
   "name": "--total",
   "description": "When to print a line with total counts",
   "args": {
    "name": "when"
   }
  },
  {
   "name": [
    "-w",
    "--words"
   ],
   "description": "Print the word counts"
  },
  {
   "name": [
    "-h",
    "--help"
   ],
   "description": "Print help"
  },
  {
   "name": [
    "-V",
    "--version"
   ],
   "description": "Print version"
  }
 ],
 "args": {
  "name": "file",
  "template": "filepaths",
  "isVariadic": true,
  "isOptional": true
 }
}
