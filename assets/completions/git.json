{
 "name": "git",
 "description": "The stupid content tracker",
 "subcommands": [
  {
   "name": "add",
   "description": "Add file contents to the index",
   "options": [
    {
     "name": [
      "-A",
      "--all"
     ],
     "description": "Add all changes"
    },
    {
     "name": [
      "-p",
      "--patch"
     ],
     "description": "Pick hunks interactively"
    },
    {
     "name": [
      "-u",
      "--update"
     ],
     "description": "Only stage tracked files"
    },
    {
     "name": [
      "-n",
      "--dry-run"
     ],
     "description": "Show what would be added"
    },
    {
     "name": [
      "-f",
      "--force"
     ],
     "description": "Allow ignored files"
    }
   ],
   "args": {
    "name": "path",
    "template": "filepaths",
    "isVariadic": true,
    "isOptional": true
   },
   "priority": 75
  },
  {
   "name": "bisect",
   "description": "Find the commit that introduced a bug",
   "subcommands": [
    {
     "name": "start",
     "description": "Start bisecting"
    },
    {
     "name": "good",
     "description": "Mark a commit good"
    },
    {
     "name": "bad",
     "description": "Mark a commit bad"
    },
    {
     "name": "skip",
     "description": "Skip a commit"
    },
    {
     "name": "reset",
     "description": "End bisecting"
    },
    {
     "name": "log",
     "description": "Show the bisect log"
    }
   ]
  },
  {
   "name": "blame",
   "description": "Show who last changed each line",
   "options": [
    {
     "name": "-L",
     "description": "Only these lines",
     "args": {
      "name": "start,end"
     }
    },
    {
     "name": "-w",
     "description": "Ignore whitespace"
    }
   ],
   "args": {
    "name": "file",
    "template": "filepaths"
   }
  },
  {
   "name": "branch",
   "description": "List, create or delete branches",
   "options": [
    {
     "name": [
      "-a",
      "--all"
     ],
     "description": "List remote branches too"
    },
    {
     "name": [
      "-r",
      "--remotes"
     ],
     "description": "List remote branches"
    },
    {
     "name": [
      "-d",
      "--delete"
     ],
     "description": "Delete a merged branch"
    },
    {
     "name": "-D",
     "description": "Delete a branch even if unmerged"
    },
    {
     "name": [
      "-m",
      "--move"
     ],
     "description": "Rename a branch"
    },
    {
     "name": [
      "-v",
      "--verbose"
     ],
     "description": "Show the last commit of each branch"
    },
    {
     "name": "--show-current",
     "description": "Print the current branch"
    }
   ],
   "args": {
    "name": "branch",
    "isOptional": true
   }
  },
  {
   "name": "checkout",
   "description": "Switch branches or restore files",
   "options": [
    {
     "name": "-b",
     "description": "Create a branch and switch to it",
     "args": {
      "name": "new branch"
     }
    },
    {
     "name": "-B",
     "description": "Create or reset a branch and switch to it",
     "args": {
      "name": "branch"
     }
    },
    {
     "name": [
      "-f",
      "--force"
     ],
     "description": "Throw away local changes"
    },
    {
     "name": "--",
     "description": "Only files follow"
    }
   ],
   "args": {
    "name": "path",
    "template": "filepaths",
    "isVariadic": true,
    "isOptional": true
   },
   "priority": 75
  },
  {
   "name": "cherry-pick",
   "description": "Apply the changes of existing commits",
   "options": [
    {
     "name": "--continue",
     "description": "Continue after resolving conflicts"
    },
    {
     "name": "--abort",
     "description": "Cancel the cherry-pick"
    },
    {
     "name": [
      "-n",
      "--no-commit"
     ],
     "description": "Apply without committing"
    },
    {
     "name": "-x",
     "description": "Record where the commit came from"
    }
   ],
   "args": {
    "name": "commit",
    "isVariadic": true
   }
  },
  {
   "name": "clean",
   "description": "Remove untracked files",
   "options": [
    {
     "name": [
      "-n",
      "--dry-run"
     ],
     "description": "Show what would be removed"
    },
    {
     "name": [
      "-f",
      "--force"
     ],
     "description": "Really remove"
    },
    {
     "name": "-d",
     "description": "Remove untracked directories too"
    },
    {
     "name": "-x",
     "description": "Remove ignored files too"
    }
   ]
  },
  {
   "name": "clone",
   "description": "Clone a repository into a new directory",
   "options": [
    {
     "name": "--depth",
     "description": "Only this many recent commits",
     "args": {
      "name": "depth"
     }
    },
    {
     "name": [
      "-b",
      "--branch"
     ],
     "description": "Check out this branch",
     "args": {
      "name": "branch"
     }
    },
    {
     "name": "--recurse-submodules",
     "description": "Clone submodules too"
    }
   ],
   "args": [
    {
     "name": "repository"
    },
    {
     "name": "directory",
     "template": "folders",
     "isOptional": true
    }
   ],
   "priority": 70
  },
  {
   "name": "commit",
   "description": "Record changes to the repository",
   "options": [
    {
     "name": [
      "-m",
      "--message"
     ],
     "description": "Use this commit message",
     "args": {
      "name": "message"
     }
    },
    {
     "name": [
      "-a",
      "--all"
     ],
     "description": "Stage modified and deleted files first"
    },
    {
     "name": "--amend",
     "description": "Replace the last commit"
    },
    {
     "name": "--no-edit",
     "description": "Keep the message"
    },
    {
     "name": [
      "-v",
      "--verbose"
     ],
     "description": "Show the diff in the message editor"
    },
    {
     "name": "--fixup",
     "description": "Make a fixup commit",
     "args": {
      "name": "commit"
     }
    },
    {
     "name": [
      "-S",
      "--gpg-sign"
     ],
     "description": "Sign the commit"
    },
    {
     "name": "--no-verify",
     "description": "Skip the commit hooks"
    }
   ],
   "priority": 80
  },
  {
   "name": "config",
