   "description": "Remove all packages which match <package>"
  },
  {
   "name": "--badreloc",
   "description": "Relocate files in non-relocatable package"
  },
  {
   "name": [
    "-e",
    "--erase"
   ],
   "description": "Erase (uninstall) package",
