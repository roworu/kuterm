  },
  {
   "name": "--nodb",
   "description": "Do not update the database, but modify"
  },
  {
   "name": "--nocontexts",
   "description": "Don't install file security contexts"
  },
  {
   "name": "--nocaps",
   "description": "Don't install file capabilities"
